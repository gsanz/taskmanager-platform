generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  users User[]

  @@map("roles")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  secondname String?  @db.VarChar(100)
  telefonoEmpresa String? @map("telefono_empresa") @db.VarChar(30)
  telefonoCorto String? @map("telefono_corto") @db.VarChar(15)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  mustChangePassword Boolean @default(true) @map("must_change_password")
  roleId    String?  @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  role    Role?          @relation(fields: [roleId], references: [id])
  tareas  TareaUsuario[]
  taskLogs TaskLog[]

  @@map("users")
}

model TareaUsuario {
  id              String   @id @default(uuid()) @db.Uuid
  nombre          String   @db.VarChar(255)
  fechaInicio     DateTime @map("fecha_inicio") @db.Date
  horasEstimadas  Decimal  @map("horas_estimadas") @db.Decimal(5, 2)
  userId          String   @map("user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  user    User      @relation(fields: [userId], references: [id])
  taskLogs TaskLog[]

  @@map("tareas_usuario")
}

model TaskLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tareaId     String   @map("tarea_id") @db.Uuid
  tareaNombre String   @map("tarea_nombre") @db.VarChar(255)
  fecha       DateTime @map("fecha") @db.Date
  descripcion String?  @db.Text
  horas       Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  user  User         @relation(fields: [userId], references: [id])
  tarea TareaUsuario @relation(fields: [tareaId], references: [id])

  @@map("task_log")
  @@index([userId, fecha])
  @@index([tareaId])
}
